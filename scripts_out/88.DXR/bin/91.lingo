on new me
                            
    set_property("spriteList", transpose(<BoatStart, 6, Sky, 1));            
    return(me)    
end new

on init me
    global gMulleGlobals
                
    setSky(the gMulleGlobals.weather )                        
    drawBoat(point(340, 280))            
    cursor(200)    
end init

on startMovie me
    global gMulleGlobals
                    
    if objectp(the gMulleGlobals.world ) then                                        
        put getEnteredObject(the gMulleGlobals.world ) into objId        

    else
                
        put 0 into objId
    end if
        
    put 0 into tempObj                    
    put getBoat(the gMulleGlobals.user ) into tmpBoat                        
    if isMissionCompleted(the gMulleGlobals.user , 24) then                
        set_property("myMarker", "Done");        

    else
                                                
        if isMissionCompleted(the gMulleGlobals.user , 11) then                                                            
            if getProperty(tmpBoat, Watertank) then                                
                set_property("myMarker", "JustDoit");                                                                                
                addCompletedMission(the gMulleGlobals.user , 24)                                                                                                                
                setInInventory(the gMulleGlobals.user , Fishingrod, transpose(<))                

            else
                                
                set_property("myMarker", "cantDoIt");
            end if
            

        else
                        
            set_property("myMarker", "cantDoIt");
        end if
    end if
                
    if (the myMarker <> "cantDoiT") then                        
        go(the myMarker)        

    else
                        
        go("start")
    end if
    
end startMovie

on kill me
            
    return(0)    
end kill

