on exitFrame 
    global gMulleGlobals
                                
    if isInInventory(the gMulleGlobals.user , DoctorBag, <) then                                                        
        deleteFromInventory(the gMulleGlobals.user , DoctorBag, <)                        
        go("SCJustDoItPrimaBag")        

    else
                                                
        go((the frame + 1))
    end if
    
end exitFrame

