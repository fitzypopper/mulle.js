on beginSprite me
            
    set_property("SP", the me.spriteNum );                                                                                    
    set_property("spriteList", transpose(<ArrowUp, the arrowUpSP, ArrowDown, the arrowDownSP, ScrollerBehind, the scrollerBehindSP, ScrollerUp, the scrollerUpSP, ScrollerMid, the scrollerMidSP, ScrollerDown, the scrollerDownSP, EnterField, the enterFieldSP, trash, the trashSP, Dragger, the draggerSP));        
    if not the RelativeSP then exit repeat        
    put 1 into N
    repeat while TRUE
                                                
        if not (N <= count(the spriteList)) then exit repeat                                                        
        if (getAt(the spriteList, N) <> 0) then                                                                                                                        
            setAt(the spriteList, N, (the SP + getAt(the spriteList, N)))
        end if
                                
        put (1 + N) into N        

    end repeat
end repeat

