property masterSP, ScrollBHType, SP, mouseOnMe, childSprites, topLimit, grabbedOffset, mySpace, regTopOffset, regPointPercent, myHeight, myTop, waitFrames
on beginSprite me
    set SP = spriteNum
    set childSprites = [1]
end

on init me, theMasterSP
    set masterSP = theMasterSP
end

on SetChildren me, theList
    set childSprites = duplicate(theList)
    set tempRect = the rect of sprite getAt
    set limits = [getAt(tempRect, 2), getAt(tempRect, 4)]
    set topLimit = getAt(tempRect, 2)
    set mySpace = (getAt(tempRect, 4) - getAt(tempRect, 2))
    set regPointPercent = ((100 * getAt(the regPoint of the UNKNOWN37 of sprite SP, 2)) / getAt(the rect of the UNKNOWN37 of sprite SP, 4))
end

on mouseDown me
    set mouseOnMe = 1
    if (ScrollBHType = #ScrollerMid) then
        set grabbedOffset = (the mouseV - the locV of sprite SP)
    else
        if (ScrollBHType = #ScrollerBehind) then
            set tempMouse = the mouseV
            set tempScroll = 0
            if (tempMouse < myTop) then
                set tempScroll = -1
            else
                if (tempMouse > (myTop + myHeight)) then
                    set tempScroll = 1
                end if
            end if
            sendSprite masterSP, #scroll, #Page, tempScroll
        else
            if ((ScrollBHType = #ArrowUp) or (ScrollBHType = #ArrowDown)) then
                set waitFrames = 0
                exitFrame me
                set waitFrames = 3
            end if
        end if
    end if
end

on mouseUp me
    set mouseOnMe = 0
end

on mouseUpOutSide me
    set mouseOnMe = 0
end

on setScrollInfo me, thePercentDown, thePercentFilled
    if (ScrollBHType = #ScrollerMid) then
        if integerp(thePercentFilled) then
            set myHeight = ((mySpace * thePercentFilled) / 100)
            if (myHeight < 20) then
                set myHeight = 20
            end if
            set the height of sprite SP = myHeight
            set tempRect = the rect of sprite SP
            set regTopOffset = ((myHeight * regPointPercent) / 100)
        end if
        set tempDown = ((thePercentDown * (mySpace - myHeight)) / 10)
        set myTop = (topLimit + tempDown)
        set the locV of sprite SP = (myTop + regTopOffset)
        setScrollEnds me
    else
        if (ScrollBHType = #ScrollerBehind) then
            set myTop = thePercentDown
            set myHeight = thePercentFilled
        end if
    end if
end

on setScrollEnds me
    if (getAt(childSprites, 2) > 0) then
        set the locV of sprite getAt = myTop
        set the locV of sprite getAt = (myTop + myHeight)
    end if
    sendSprite getAt(childSprites, 1), #setScrollInfo, myTop, myHeight
end

on exitFrame me
    if (ScrollBHType = #ScrollerMid) then
        if mouseOnMe then
            set goFor = (the mouseV - grabbedOffset)
            if (goFor < (regTopOffset + topLimit)) then
                set tempLocV = (regTopOffset + topLimit)
            else
                if (goFor > (((regTopOffset + topLimit) + mySpace) - myHeight)) then
                    set tempLocV = (((regTopOffset + topLimit) + mySpace) - myHeight)
                else
                    set tempLocV = goFor
                end if
            end if
            set the locV of sprite SP = tempLocV
            set myTop = (tempLocV - regTopOffset)
            set tempMaxDown = (mySpace - myHeight)
            if (tempMaxDown = 0) then
                set tempMaxDown = 1
            end if
            sendSprite masterSP, #scroll, #percent, ((100 * (myTop - topLimit)) / tempMaxDown)
            setScrollEnds me
        end if
    else
        if ((ScrollBHType = #ArrowUp) or (ScrollBHType = #ArrowDown)) then
            if mouseOnMe then
                if waitFrames then
                    set waitFrames = (waitFrames - 1)
                else
                    if (ScrollBHType = #ArrowUp) then
                        sendSprite masterSP, #scroll, #Relative, -1
                    else
                        sendSprite masterSP, #scroll, #Relative, 1
                    end if
                end if
            end if
        end if
    end if
end

on getPropertyDescriptionList me
    set p_list = [#ScrollBHType: [#comment: "This sprite is:", #format: #symbol, #range: [#ArrowUp, #ArrowDown, #ScrollerUp, #ScrollerMid, #ScrollerDown, #ScrollerBehind], #default: #ArrowUp]]
    return p_list
end
