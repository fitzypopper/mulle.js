on new me
    global gMulleGlobals
        
    set_property("OKToTalk", 1);        
    set_property("dialogClosed", 1);            
    set_property("mouseObjectList", <);                                                            
    set_property("spriteList", transpose(<Sky, 1, ShelfNr, 3, JunkStart, 6, DragPart, 90, dialog, 95, DialogOverlay, 96));                    
    set_property("firstDialogList", <"02d002v0", "02d003v0");                                    
    set_property("genDialogList", <"02d004v0", "00d001v0", "00d002v0", "00d003v0", "00d004v0", "00d005v0");                        
    set_property("loopCounter", (120 + random(360)));                        
    set_property("FirstTime", getaProp(the gMulleGlobals.firstTimeList , Shelf));                    
    if (not voidp(the FirstTime)) then                
        if the FirstTime then                        
            set_property("loopCounter", 12);                                                                        
            setaProp(the gMulleGlobals.firstTimeList , Shelf, 0)
        end if
        

    else
                
        set_property("FirstTime", 0);
    end if
            
    safePreload("02e003v0")            
    safePreload("00e110v0")            
    return(me)    
end new

