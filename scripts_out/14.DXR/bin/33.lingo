on scroll me, theMode, how
                
    if (theMode = Relative) then                                                                                                                                
        if (((the lineNr + how) > 0) and ((the lineNr + how) <= ((the nrOfLines - the visibleLines) + 1))) then                                                
            set_property("lineNr", (the lineNr + how));                                                                        
            scrollByLine(member(the myMember), how)                                                
            put (the nrOfLines - the visibleLines) into tempNrOf                                                
            if (tempNrOf = 0) then                                
                put 1 into tempNrOf
            end if
                                                                                                
            put ((100 * (the lineNr - 1)) / tempNrOf) into tempPercent                                                                                                
            sendSprite(getProp(the spriteList, ScrollerMid), setScrollInfo, tempPercent)
        end if
        

    else
                                
        if (theMode = Absolute) then                                                
            if (how < 1) then                                
                put 1 into how
            end if
                                                
            put (how - the lineNr) into diff                        
            set_property("lineNr", how);                                                                        
            scrollByLine(member(the myMember), diff)            

        else
                                                
            if (theMode = percent) then                                                                                                                                                                                                
                put (1 + integer(((how * (the nrOfLines - the visibleLines)) / 100.0))) into how                                                                                
                put correctLine(me, how) into how                                                                
                put (how - the lineNr) into diff                                
                set_property("lineNr", how);                                                                                                
                scrollByLine(member(the myMember), diff)                

            else
                                                                
                if (theMode = Page) then                                                                                                                        
                    put (the lineNr + (how * the visibleLines)) into how                                                                                                    
                    put correctLine(me, how) into how                                                                                
                    put (how - the lineNr) into diff                                        
                    set_property("lineNr", how);                                                                                
                    put (the nrOfLines - the visibleLines) into tempNrOf                                                                                
                    if (tempNrOf = 0) then                                                
                        put 1 into tempNrOf
                    end if
                                                                                                                                                                
                    put ((100 * (the lineNr - 1)) / tempNrOf) into tempPercent                                                                                                                                                                
                    sendSprite(getProp(the spriteList, ScrollerMid), setScrollInfo, tempPercent)                                                                                                                        
                    scrollByLine(member(the myMember), diff)                    

                else
                                                                                
                    if (theMode = Match) then                                                                                                
                        add(the textList, how)                                                                                                                        
                        put getPos(the textList, how) into how                                                                                                
                        deleteAt(the textList, how)                                                                                                
                        put (how - 1) into how                                                                                                                        
                        put correctLine(me, how) into how                                                                                                
                        put (how - the lineNr) into diff                                                
                        set_property("lineNr", how);                                                                                                
                        put (the nrOfLines - the visibleLines) into tempNrOf                                                                                                
                        if (tempNrOf = 0) then                                                        
                            put 1 into tempNrOf
                        end if
                                                                                                                                                                                                
                        put ((100 * (the lineNr - 1)) / tempNrOf) into tempPercent                                                                                                                                                                                                
                        sendSprite(getProp(the spriteList, ScrollerMid), setScrollInfo, tempPercent)                                                                                                                                                
                        scrollByLine(member(the myMember), diff)
                    end if
                end if
            end if
        end if
    end if
    
end scroll

on deleteLine me, theLine
                
    if stringp(theLine) then                                                                
        put offset(theLine, the member(the myMember).text ) into tempOff                
        if tempOff then                                                                                                                                                                                                
            put the number of lines of char 1 to tempOff of the member(the myMember).text  into theLine            

        else
            

            exit

        end if
    end if
                                
    if ((theLine > 0) and (theLine <= the nrOfLines)) then                                
        set_property("nrOfLines", (the nrOfLines - 1));                                
        if (theLine <= the lineNr) then                                                
            set_property("lineNr", (the lineNr - 1));            

        else
                                                                                                
            if (the lineNr = ((the nrOfLines - the visibleLines) + 1)) then                                                                
                set_property("lineNr", (the lineNr - 1));
            end if
        end if
                                        
        set_property("lineNr", correctLine(me, the lineNr));                                
        deleteAt(the textList, theLine)                                
        setText(me, the textList)                                
        resultsFromScroller(DeletedLine, theLine)
    end if
    
end deleteLine

on AllowedToAdd me, YesNo
        
    set_property("isAllowedToAdd", YesNo);    
end AllowedToAdd

on AddLine me, theLine
                                        
    put offset((theLine & return), the member(the myMember).text ) into tempOff                
    if (tempOff = 0) then                                
        if count(the textList) then                                                                                                            
            put (theLine = getAt(the textList, count(the textList))) into tempOff
        end if
    end if
                
    if (tempOff = 0) then                
        if the isAllowedToAdd then                                                
            add(the textList, theLine)                                                            
            set_property("lineNr", getPos(the textList, theLine));                                                            
            set_property("lineNr", correctLine(me, the lineNr));                                                
            setText(me, the textList)                                                
            resultsFromScroller(NewLine, theLine)
        end if
        

    else
                                
        resultsFromScroller(ChoseLine, theLine)
    end if
    
end AddLine

on correctLine me, theLine
                
    if (theLine <= 1) then                
        put 1 into theLine        

    else
                                                                
        if (theLine > ((the nrOfLines - the visibleLines) + 1)) then                                                                        
            put ((the nrOfLines - the visibleLines) + 1) into theLine
        end if
    end if
                
    if (the nrOfLines < the visibleLines) then                
        put 1 into theLine
    end if
            
    return(theLine)    
end correctLine

