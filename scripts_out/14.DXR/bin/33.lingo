on getPropertyDescriptionList me
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
    put transpose(<AutoFind, transpose(<comment, "Autofind necessary sprites: (might be slow)", format, boolean, default, 0), RelativeSP, transpose(<comment, "Sprite channels are offsets:", format, boolean, default, 1), enterFieldSP, transpose(<comment, "Use these channels (0 = unused):          Enter in field:", format, integer, default, -8), trashSP, transpose(<comment, "Trash:", format, integer, default, -7), scrollerBehindSP, transpose(<comment, "Behind scrollbar:", format, integer, default, -6), scrollerMidSP, transpose(<comment, "Scrollbar stretch:", format, integer, default, -5), scrollerUpSP, transpose(<comment, "Scrollbar top:", format, integer, default, -4), scrollerDownSP, transpose(<comment, "Scrollbar bottom:", format, integer, default, -3), arrowUpSP, transpose(<comment, "Arrow up:", format, integer, default, -2), arrowDownSP, transpose(<comment, "Arrow down:", format, integer, default, -1), draggerSP, transpose(<comment, "Drag text:", format, integer, default, 1)) into p_list            
    return(p_list)    
end getPropertyDescriptionList

on getBehaviorDescription me
                                                                                                                                                        
    put (((((((((((((((((("This BH is to be assigned to the scrolling field." & return) & "The arrows and scrollbars must be in lower (than this ch) numbered channels") & return) & "while drag text must be in a higher numbered channel.") & return) & return) & "Results from clicking, entering new lines will be reported") & return) & "to a global handler:") & return) & "on resultsFromScroller resultType, aString") & return) & return) & "resultType = #ChoseLine (aString = chosen string)") & return) & "resultType = #NewLine (aString = new string)") & return) & "resultType = #DeletedLine (aString = deleted string)") into str            
    return(str)    
end getBehaviorDescription

