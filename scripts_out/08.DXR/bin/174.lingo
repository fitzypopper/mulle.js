on changeRect val, startMemb, endMemb
        
    put startMemb into N
    repeat while TRUE
                                
        if not (N <= endMemb) then exit repeat                                        
        put the member(N).rect  into tempRect                                                                                                        
        put rect(0, 0, val, getAt(tempRect, 4)) into member(N).rect                                         
        ERROR: Missing subcommand! (0x09) :(                                        
        ERROR: Missing subcommand! (0x09) :(                                
        put (1 + N) into N        
        7
        16
        0
        N
        4
        "Times"
        0
        N

    end repeat
    
end changeRect

